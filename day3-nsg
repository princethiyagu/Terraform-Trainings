#create a new file nsg.tf copy from line 3 till 14
  #we will create an nsg for our vm
resource "azurerm_network_security_group" "web_nsg" {
  name                = "${local.resource_name_prefix}-nsg"
  location            = azurerm_resource_group.my_rg.location #it get from the state file
  resource_group_name = azurerm_resource_group.my_rg.name

  tags = local.project_tags
}
#nsg need to be attached with my subnet
resource "azurerm_subnet_network_security_group_association" "web_nsg_association" {
  subnet_id                 = azurerm_subnet.web_subnet.id 
  network_security_group_id = azurerm_network_security_group.web_nsg.id
}

#inside nsg.tf file at the end add this lines from 17 till 41 then do terraform plan see the resource group is replicated multiple times
locals {
  web_nsg_rule = { #named gopal #men clothing
    "110" : "22", #expression in key value format priority and port number s
    "120" : "80", #me
    "130" : "443" #large
  }
 }
#IF I CALL local.web_nsg_rule will all this three priority and port will be called 


#lets create the network security rule
resource "azurerm_network_security_rule" "web_nsg_rule" { #men section
  for_each = local.web_nsg_rule 
  name                        = "Rule_port_${each.value}" #22 80
  priority                    = each.key #110 120
  direction                   = "Inbound"
  access                      = "Allow"
  protocol                    = "Tcp"
  source_port_range           = "*" #0.0.0.0/0
  destination_port_range      = each.value #22 80
  source_address_prefix       = "*"
  destination_address_prefix  = "*"
  resource_group_name         = azurerm_resource_group.my_rg.name
  network_security_group_name = azurerm_network_security_group.web_nsg.name
}
